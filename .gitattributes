# Preserve captured CSV bytes and accept the standard csv module's CRLF records.
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Engine-generated plan text is evidence; retain its original spacing.
evidence-h100/**/plans/*.txt -text -whitespace
# Matplotlib emits significant SVG path data with spaces before line breaks.
reports/**/*.svg -text -whitespace
